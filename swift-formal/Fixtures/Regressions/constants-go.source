package main
func compareConstant(a int64, b int64) bool { return 9223372036854775807 + 1 < 0 }
func narrowAfterFold(a int64, b int64) int64 { return 9223372036854775807 + 1 - 1 }
func mixedConstant(a int64, b int64) int64 { return a + (9223372036854775807 + 1 - 9223372036854775807) }
func mixedUnsigned(a uint64, b uint64) uint64 { return a + (18446744073709551615 + 1 - 18446744073709551615) }
func compareUnsigned(a uint64, b uint64) bool { return a < 18446744073709551615 + 1 - 18446744073709551615 }
func negateComparison(a int64, b int64) bool { return !(9223372036854775807 + 1 < 0) }
func typedWrap(a int64, b int64) bool { return a + 1 < 0 }
func multiplyConstant(a int64, b int64) bool { return 9223372036854775807 * 2 > 0 }
func negativeConstant(a int64, b int64) bool { return -9223372036854775807 - 2 < 0 }
func precisionBoundary(a int64, b int64) bool { return 9999999999999999999999999999999999999999999999999999999999999999999999999999 > 0 }
